# Rendered by Ansible. Contains credentials: never commit.
HYDROC_S3_ENDPOINT=https://{{ bucket_endpoint }}
HYDROC_S3_RAW_KEY={{ bucket_keys.raw.access_key }}
HYDROC_S3_RAW_SECRET={{ bucket_keys.raw.secret_key }}
HYDROC_S3_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

HYDROC_QUACK_URL=quack:{{ instance_ips['hydroc-duckdb'] }}:{{ quack_port }}
HYDROC_QUACK_TOKEN={{ vault_quack_token }}
# The quack server only speaks plain HTTP
HYDROC_QUACK_DISABLE_SSL=true
