# Copy to vault.yml (git-ignored), fill in, and optionally encrypt:
#   ansible-vault encrypt group_vars/all/vault.yml
vault_pg_passwords:
  lake: change-me
  library: change-me
  dwh: change-me
  hook: change-me
  serve: change-me      # hydroc_serve, written by the DuckDB server
  metabase: change-me   # Metabase's application database + read access to hydroc_serve

# Shared by the quack server and its clients (min. 4 characters).
# Values are embedded in SQL literals: do not use single quotes.
vault_quack_token: change-me

# Metabase admin, created on the first run of the metabase role. Metabase
# rejects weak passwords: at least 8 characters with letters and digits.
vault_metabase_admin_email: admin@example.com
vault_metabase_admin_password: change-me-1234
