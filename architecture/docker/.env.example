# Copy to .env (git-ignored) and change every value.
# Values are embedded in SQL literals: do not use single quotes.

# RustFS root credentials (also used by DuckDB and the app; min. 8 characters)
RUSTFS_ACCESS_KEY=hydrocadmin
RUSTFS_SECRET_KEY=change-me-please

# Postgres superuser and one password per DuckLake catalog user
PG_SUPERUSER_PASSWORD=change-me
PG_PASSWORD_LAKE=change-me
PG_PASSWORD_LIBRARY=change-me
PG_PASSWORD_DWH=change-me
PG_PASSWORD_HOOK=change-me
# Serving database (written by DuckDB) and Metabase's own user (application
# database + read-only access to the serving database)
PG_PASSWORD_SERVE=change-me
PG_PASSWORD_METABASE=change-me

# Shared by the quack server and its clients (min. 4 characters)
QUACK_TOKEN=change-me

# Metabase admin, created on first start by metabase-init. Metabase rejects
# weak passwords: use at least 8 characters with letters and digits.
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=change-me-1234
# Optional: Metabase image tag (default in compose.yaml) and public URL
# METABASE_VERSION=v0.65.3.3
# MB_SITE_URL=http://127.0.0.1:3000
