# Copy to .env (git-ignored). On hydroc-app this file is rendered by Ansible.

# Raw layer: Incus S3 bucket endpoint and the hydroc-raw bucket key
HYDROC_S3_ENDPOINT=https://<incus-host>:8555
HYDROC_S3_RAW_KEY=
HYDROC_S3_RAW_SECRET=
# CA bundle trusting the Incus server certificate (empty = system default)
HYDROC_S3_CA_BUNDLE=

# DuckDB quack server (hydroc-duckdb)
HYDROC_QUACK_URL=quack:10.10.40.20:9494
HYDROC_QUACK_TOKEN=
HYDROC_QUACK_DISABLE_SSL=true
